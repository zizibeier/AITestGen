# ============================================================
# my_auto_test 配置模板
# 使用方式：
#   cp .env.example .env
# 然后在 .env 中填入真实值。.env 已被 .gitignore 忽略。
# 留空的配置项会让依赖它的在线用例自动跳过。
# ============================================================

# ---------- Forface OpenAPI（api/tests） ----------
# 未配置时，使用 api_context / endpoints 的在线接口用例会被跳过。
API_APP_ID=
API_APP_SECRET=

# ---------- JLC 3D Viewer UI（ui/tests） ----------
# 仅当 Config.AUTO_LOGIN = True 时使用。
UI_USERNAME=
UI_PASSWORD=

# ---------- AI 断言（OpenAI Chat Completions 兼容协议） ----------
# 三项全部配置后，AI 断言在线用例才会执行。
AI_ASSERT_API_KEY=
AI_ASSERT_BASE_URL=
AI_ASSERT_MODEL=

# ---------- Cerebras（common/utils/cerebars.py） ----------
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# ---------- Webhook 回调 ----------
# 需指向可被被测服务访问的回调服务。
WEBHOOK_BASE_URL=
WEBHOOK_KEY=
WEBHOOK_TIMEOUT=180

# ---------- 邮件报告（QQ 邮箱使用授权码，不是登录密码） ----------
EMAIL_SMTP_SERVER=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SENDER=
EMAIL_PASSWORD=
# 多个收件人用英文逗号分隔
EMAIL_RECIPIENTS=
EMAIL_SUBJECT_PREFIX=[测试]

# ---------- Builder 在线用例（可选） ----------
BUILDER_WEB_TOKEN=
BUILDER_WEB_COOKIE=
BUILDER_USER_ID=
BUILDER_WEBHOOK_KEY=
BUILDER_TEST_MODEL_KEY=
BUILDER_TEST_MODEL_NAME=
API_AUTO_LOGIN=true

# ---------- Builder 历史脚本（legacy_scripts/BuilderDataManager.py） ----------
LEGACY_BUILDER_USERNAME=
LEGACY_BUILDER_PASSWORD=
LEGACY_BUILDER_WEB_TOKEN=
